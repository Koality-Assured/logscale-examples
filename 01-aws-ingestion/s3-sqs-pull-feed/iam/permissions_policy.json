{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSQSPolling",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:ChangeMessageVisibility"
      ],
      "Resource": "arn:aws:sqs:us-east-1:123456789012:logscale-ingest-queue-prod"
    },
    {
      "Sid": "AllowS3ReadObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::example-corp-logscale-archive-prod",
        "arn:aws:s3:::example-corp-logscale-archive-prod/*"
      ]
    }
  ]
}
