{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowLogscaleAssumeRole",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::426876924399:role/cs_logscale_granter_role"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "sts:ExternalId": "REPLACE_WITH_LOGSCALE_EXTERNAL_ID"
        }
      }
    }
  ]
}
